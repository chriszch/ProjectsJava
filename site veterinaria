<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agendamento, - Clínica veterinária</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Agendamento de Consulta Veterinária</h1>

        <form id="agendamentoForm">
            <div class="form-group">
                <label for="nomeTutor">Nome do Tutor:</label>
                <input type="text"id="nomeTutor" required>
                </div>
            
                <div class="form-group">
                    <label for="nomePet">Nome do Pet:</label>
                    <input type="text"id="nomePet" required>
                </div>

                <div class="form-group">
                    <label for="especie">Espécie:</label>
                    <select id="especie" required>
                        <option value="Cão">Cão</option>
                        <option value="Gato">Gato</option>
                        <option value="Outro">Outro</option>
                    </select>
                    <label for="genero">Gênero:</label>
                    <select id="genero" required>
                        <option value="macho">macho</option>
                        <option value="fêmea">fêmea</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="dataHora">Data e Horário:</label>
                    <input type="datetime-local"id="dataHora" required>
                </div>

                <div class="form-group">
                    <label for="observacoes">Observações:</label>
                    <textarea id="observacoes" rows="3"></textarea>
                </div>

                <button type="submit">Agendar Consulta</button>
        </form>
        <h2>Consultas Agendadas</h2>
        <table id="tabelaConsultas">
            <thead>
                <tr>
                    <th>Tutor</th>
                    <th>Pet</th>
                    <th>Espécie</th>
                    <th>Data/Hora</th>
                </tr>
            </thead>
            <tbody>
                
            </tbody>
        </table>
	</div>
		
		<script>
			const form = document.getElementById('agendamentoForm');
			const form = document.getElementById('tabelaConsultas').querySelector('body');
			
			form.addEventListener('submit', function(e) {
				e.preventDefault();
			
			const agendamento = {
				nomeTutor: documment.getElementById('nomeTutor').value,
				nomePet: documment.getElementById('nomePet').value,
				especie: documment.getElementById('especie').value,
				genero: documment.getElementById('genero').value,
				dataHora: documment.getElementById('dataHora').value,
				observacoes: documment.getElementById('observacoes').value
			};
			
			fetch('http://localhost:8080/api/agendamentos',){
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(agendamento)
			})
			
			.then(response => response.text())
			.then(data => {
				alert(data);
				
				const novaLinha = tabela.insertRow();
				novaLinha.insertCell(0).innerText = agendamento.nomeTutor;
				novaLinha.insertCell(1).innerText = agendamento.nomePet;
				novaLinha.insertCell(2).innerText = agendamento.especie;
				novaLinha.insertCell(3).innerText = agendamento.dataHora;
				
				form,reset();
			})
			.catch(error => {
				console.error('Erro ao conectar com a API', error);
				alert('Ocorreu um erro ao conectar com o servidor java');
				
				});
			});
		</script>	
</body>
</html>
